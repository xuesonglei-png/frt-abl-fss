      "unit": "equation",
      "target": "由 0/1/+/= 组成的方程真假",
      "order": 6
    }
  },
  "metrics": {
    "task_accuracy": {
      "display": "任务准确率",
      "direction": "higher",
      "definition": "预测结果与整式目标一致的样本数 / 样本总数；MNIST 加法为 pair 级，HWF 为表达式级"
    },
    "symbol_accuracy": {
      "display": "符号准确率",
      "direction": "higher",
      "definition": "逐图像 argmax 正确的符号数 / 符号总数；不同分母，不与任务准确率互换"
    },
    "equation_accuracy": {
      "display": "方程判定准确率",
      "direction": "higher",
      "definition": "决策层 (probabilities > 0.5) == y 的方程数 / 方程总数；二分类，不是求和任务"
    }
  },
